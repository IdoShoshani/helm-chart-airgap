# Flask Configuration
FLASK_PORT=8000
# Set to true for debug mode; with ./backend mounted in docker-compose, code changes auto-reload
FLASK_DEBUG=false
SECRET_KEY=dev-secret-key-change-in-production

# Data Directory (relative to project root)
DATA_DIR=./data

# Helm Settings (timeouts in seconds)
HELM_TIMEOUT=300
HELM_RETRY_LIMIT=3

# Image Pull Settings (timeout per image in seconds; total image phase can be long with many images)
IMAGE_PULL_TIMEOUT=600
MAX_IMAGES=100
MAX_BUNDLE_SIZE_GB=50
# Number of images to pull in parallel (fail on first error)
IMAGE_PULL_PARALLEL=5

# Repositories: refresh chart list every N hours (0 = no automatic refresh)
REPO_UPDATE_INTERVAL_HOURS=6

# Registry Credentials (Optional)
# If your charts/images require authentication, set these:
# REGISTRY_USERNAME=your-username
# REGISTRY_PASSWORD=your-password
# REGISTRY_SERVER=registry.example.com
